# Primary delivery: Telegram. Set both values in Vercel Environment Variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004305846803

# Option A: CRM, Make or n8n HTTPS webhook. Used when Telegram is not configured; takes precedence over email.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Option B: email via Resend. All three are required.
RESEND_API_KEY=
LEAD_EMAIL_TO=
# Use a sender on a domain verified in Resend.
LEAD_EMAIL_FROM=
