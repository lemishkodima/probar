# Primary delivery: Telegram. Set both values in Vercel Environment Variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004305846803

# Bitrix24 Classic CRM: base URL of an inbound webhook with CRM permission.
# Example: https://your-domain.bitrix24.com/rest/1/xxxxxxxxxxxxxxxx/
BITRIX24_WEBHOOK_URL=
# Optional numeric Bitrix24 user ID. If omitted, the webhook owner is responsible.
BITRIX24_ASSIGNED_BY_ID=

# Legacy fallback: used only when Telegram and Bitrix24 are not configured.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Email fallback: used only when Telegram, Bitrix24 and LEAD_WEBHOOK_URL are not configured.
RESEND_API_KEY=
LEAD_EMAIL_TO=
# Use a sender on a domain verified in Resend.
LEAD_EMAIL_FROM=
